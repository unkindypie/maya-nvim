 		})
 	}
 }
+
+// Cached semantic text is tied to the real editor snapshot, never synthetic
+// lines or a predicted cursor position used for speculative completion.
+type cachedContextBuffer struct{ *mockBuffer }
+
+func (b *cachedContextBuffer) CachedContext() string { return "schema documentation" }
+
+func TestCachedContextSnapshotIdentity(t *testing.T) {
+	e := createTestEngine(newMockBuffer(), newMockProvider(), newMockClock())
+	e.buffer = &cachedContextBuffer{newMockBuffer()}
+	assert.Equal(t, "schema documentation", e.buildCurrentSnapshot(completionInputOptions{}).SemanticContext, "real snapshot")
+	assert.Equal(t, "", e.buildCurrentSnapshot(completionInputOptions{hasCursorOverride: true, cursorRow: 2}).SemanticContext, "predicted cursor")
+	assert.Equal(t, "", e.buildCurrentSnapshot(completionInputOptions{lines: []string{"synthetic"}}).SemanticContext, "synthetic lines")
+}
