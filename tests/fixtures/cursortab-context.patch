+
+func TestCachedSemanticContext(t *testing.T) {
+	config := &types.ProviderConfig{ProviderModel: "test-model"}
+	p := NewProvider(config)
+	input := completionInput("example.py", []string{"config = {}"}, 1, 9)
+	input.Current.SemanticContext = "schema.py: Settings.theme: Theme"
+	req := buildPromptForTest(p, stateForInput(input, config))
+	assert.True(t, strings.Contains(req.Prompt, "<|file_sep|>lsp-context.txt\nschema.py: Settings.theme: Theme\n"), "cached semantic context must reach the model")
+	input.Current.SemanticContext = ""
+	req = buildPromptForTest(p, stateForInput(input, config))
+	assert.False(t, strings.Contains(req.Prompt, "lsp-context.txt"), "absent context must not create a section")
+}
